{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "FinEx React frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend-react",
				"start"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "FinEx backend API",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"uvicorn",
				"app.main:app",
				"--app-dir",
				"backend",
				"--host",
				"127.0.0.1",
				"--port",
				"8000",
				"--no-proxy-headers",
				"--no-access-log"
			],
			"options": {
				"env": {
					"APP_ENV": "local",
					"LOCAL_APP_ENABLED": "true"
				}
			},
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}
