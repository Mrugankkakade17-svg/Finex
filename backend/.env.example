# FinEx configuration template. Use placeholders only; never commit a real secret.
APP_NAME=FinEx Backend
APP_VERSION=0.1.0
APP_ENV=local
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Browser/API boundary
API_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOW_CREDENTIALS=true

# Authentication
# Set a private 32+ character value only in your local .env; leave this template blank.

# Leave disabled outside local development and automated tests.
FIXTURE_MODE=disabled

SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional providers. Leave empty when the corresponding capability is unused.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=finex_dev
DATABRICKS_SCHEMA=core
LLM_PROVIDER=none
OPENAI_API_KEY=

# S5-MI03: Local Ollama and Free Hosted LLM Cascade configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
HOSTED_LLM_PROVIDER=gemini
GEMINI_API_KEY=
HOSTED_LLM_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/google/gemma-3-12b-it
LLM_TIMEOUT_SECONDS=10.0
LLM_CASCADE_ENABLED=true
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
LOG_LEVEL=INFO
