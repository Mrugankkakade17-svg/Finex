# S2-API-01: Auth API — HTTP Evidence
# Postman-style request/response examples for all endpoints
# Base URL: http://localhost:8000

###############################################################################
# 1. POST /api/v1/auth/google/callback
# Creates or loads a user from a Google identity token (mock format for dev/test)
###############################################################################

POST http://localhost:8000/api/v1/auth/google/callback
Content-Type: application/json

{
  "id_token": "mock:alice@finex.com:Alice Smith"
}

# Expected response (200):
# {
#   "success": true,
#   "message": "Google login successful",
#   "data": {
#     "access_token": "eyJ...",
#     "refresh_token": "eyJ...",
#     "token_type": "bearer",
#     "user": { "id": 1, "email": "alice@finex.com", "name": "Alice Smith" }
#   },
#   "meta": { "correlationId": "...", "apiVersion": "v1", "dataStatus": "LIVE" }
# }

###############################################################################
# 2. POST /api/v1/auth/register
###############################################################################

POST http://localhost:8000/api/v1/auth/register
Content-Type: application/json

{
  "name": "Alice Smith",
  "email": "alice@finex.com",
  "password": "Password@123"
}

# Expected response (200):
# { "success": true, "data": { "access_token": "...", "refresh_token": "...", "token_type": "bearer" } }

###############################################################################
# 3. POST /api/v1/auth/login
###############################################################################

POST http://localhost:8000/api/v1/auth/login
Content-Type: application/json

{
  "email": "alice@finex.com",
  "password": "Password@123"
}

# Expected response (200):
# { "success": true, "data": { "access_token": "...", "refresh_token": "...", "token_type": "bearer" } }

###############################################################################
# 4. GET /api/v1/users/me  — returns full user profile
###############################################################################

GET http://localhost:8000/api/v1/users/me
Authorization: Bearer {{access_token}}

# Expected response (200):
# {
#   "success": true,
#   "data": { "id": 1, "email": "alice@finex.com", "name": "Alice Smith", "is_active": true, "role": "user" }
# }

# Without token (403):
GET http://localhost:8000/api/v1/users/me

# With bad token (401):
GET http://localhost:8000/api/v1/users/me
Authorization: Bearer invalid.token.here

###############################################################################
# 5. GET /api/v1/auth/me  — returns decoded JWT payload
###############################################################################

GET http://localhost:8000/api/v1/auth/me
Authorization: Bearer {{access_token}}

# Expected response (200):
# { "success": true, "data": { "sub": "alice@finex.com", "user_id": 1, "type": "access" } }

###############################################################################
# 6. POST /api/v1/auth/refresh  — exchange refresh token for new access token
###############################################################################

POST http://localhost:8000/api/v1/auth/refresh?token={{refresh_token}}

# Expected response (200):
# { "success": true, "data": { "access_token": "eyJ...", "token_type": "bearer" } }

# With revoked token (401):
# { "success": false, "error_code": "TOKEN_REVOKED", "message": "Token has been revoked" }

###############################################################################
# 7. POST /api/v1/auth/logout  — revokes refresh token
###############################################################################

POST http://localhost:8000/api/v1/auth/logout
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "refresh_token": "{{refresh_token}}"
}

# Expected response (200):
# { "success": true, "message": "Logout successful", "data": null }

# After logout, using old refresh_token returns 401:
POST http://localhost:8000/api/v1/auth/refresh?token={{refresh_token}}
# -> { "success": false, "error_code": "TOKEN_REVOKED" }

###############################################################################
# DONE WHEN checklist (from S2-API-01 task spec):
# [x] Valid mock identity creates or loads a user  →  test_valid_mock_token_returns_200
# [x] Expired/revoked tokens return standardized 401  →  test_refresh_after_logout_returns_401
# [x] Logout invalidates refresh token  →  test_complete_flow (step 6 asserts 401)
###############################################################################
